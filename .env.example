# ==============================================================
# Minecraft Crossplay Server Configuration (Java & Bedrock)
# ==============================================================

# Server Identity & Display
SERVER_NAME="Crossplay Minecraft Server"
MOTD="§aWelcome to our Server §7| §eJava & Bedrock Crossplay"

# Minecraft Version & Core Type
# Options for TYPE: PAPER, PURPUR, SPIGOT
TYPE=PAPER
# Set to 'LATEST' or specify a version e.g. 1.21.4
MC_VERSION=LATEST

# Hardware Resource Allocation
# Recommended: 4G minimum for crossplay with several players
MEMORY=4G

# Network Ports
JAVA_PORT=25565
BEDROCK_PORT=19132
RCON_PORT=25575

# Administration & RCON
RCON_PASSWORD=ChangeThisPassword123!

# Gameplay Settings
DIFFICULTY=normal
MAX_PLAYERS=20
MODE=survival
PVP=true
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
ONLINE_MODE=TRUE
ENFORCE_SECURE_PROFILE=false
ENABLE_COMMAND_BLOCK=true
SPAWN_PROTECTION=0
